# ==========================================
# SAFECITY PLATFORM - CONFIGURACION BASE
# ==========================================

# Entorno: development | staging | production
ENVIRONMENT=development

# Base de datos y cache
DATABASE_URL=postgresql://safecity:safecity_secret@localhost:5432/safecity_db
REDIS_URL=redis://localhost:6379/0

# Seguridad
# En produccion use un secreto largo, unico y administrado por el proveedor cloud.
JWT_SECRET_KEY=change-me-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173

# Mapas
MAPBOX_TOKEN=

# IA para agente conversacional y reportes ejecutivos.
# Si no se configura, el agente responde con motor evidencial sin LLM.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-flash-lite-latest,gemini-2.0-flash-lite

# Cuentas seed opcionales. Mantener false en produccion.
SAFECITY_CREATE_SEED_USERS=false
SAFECITY_ADMIN_EMAIL=
SAFECITY_ADMIN_PASSWORD=
SAFECITY_AUTHORITY_EMAIL=
SAFECITY_AUTHORITY_PASSWORD=
SAFECITY_CITIZEN_EMAIL=
SAFECITY_CITIZEN_PASSWORD=
SAFECITY_ASSETS_EMAIL=
SAFECITY_ASSETS_PASSWORD=

# Frontend local
VITE_API_URL=http://localhost:8000/api/v1
